<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.PromptLibraryWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="Prompt Library">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="520">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Prompt Library"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource C.Ink3}"
                       Text="Your stored lenses steer the companion's emphasis. Grounding rules always win."/>
          </StackPanel>
          <Button Grid.Column="1" Name="CloseBtn" Content="Done" FontWeight="SemiBold"
                  Foreground="{DynamicResource C.Accent}" VerticalAlignment="Top"/>
        </Grid>

        <Grid ColumnDefinitions="180,12,*">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="LENSES"/>
            <ListBox Name="LensList" Height="190" Background="Transparent"
                     BorderBrush="{DynamicResource C.Hair}" BorderThickness="1" CornerRadius="8"/>
            <Button Name="NewBtn" Content="＋ New lens" FontSize="12" Foreground="{DynamicResource C.Accent}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="lbl" Text="NAME"/>
            <TextBox Name="NameBox" FontSize="13"/>
            <TextBlock Classes="lbl" Text="PROMPT" Margin="0,4,0,0"/>
            <TextBox Name="TextBox1" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontSize="12.5"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Name="SaveBtn" Content="Save" FontWeight="SemiBold" Foreground="{DynamicResource C.Accent}"/>
              <Button Name="ActivateBtn" Content="Set active" FontSize="12"/>
              <Button Name="DeleteBtn" Content="Delete" FontSize="12" Foreground="{DynamicResource C.Bad}"/>
            </StackPanel>
            <TextBlock Name="StatusText" FontSize="11" Foreground="{DynamicResource C.Ink3}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Panel>
</Window>
