<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.QuickRepliesWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Title="ANDA Companion (Notula) — Quick replies">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="520">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Quick replies"/>
            <TextBlock FontSize="11" Foreground="{DynamicResource C.Ink3}" TextWrapping="Wrap" MaxWidth="380"
                       Text="Templates filled from the card: no AI, no network. Missing values say so."/>
          </StackPanel>
          <Button Grid.Column="1" Name="CloseBtn" Classes="primary" Content="Done" VerticalAlignment="Top"/>
        </Grid>

        <Grid ColumnDefinitions="180,12,*">
          <StackPanel Spacing="6">
            <TextBlock Classes="lbl" Text="REPLIES"/>
            <ListBox Name="ReplyList" Height="190" Background="Transparent"
                     BorderBrush="{DynamicResource C.Hair}" BorderThickness="1" CornerRadius="8"/>
            <Button Name="NewBtn" Content="＋ New reply" FontSize="12" Foreground="{DynamicResource C.Accent}"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="6">
            <TextBlock Classes="lbl" Text="NAME"/>
            <TextBox Name="NameBox" FontSize="13"/>
            <TextBlock Classes="lbl" Text="TEXT, WITH PLACEHOLDERS" Margin="0,4,0,0"/>
            <TextBox Name="TextBox1" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontSize="12.5"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Name="SaveBtn" Classes="primary" Content="Save"
                      ToolTip.Tip="Store this reply"/>
              <Button Name="DeleteBtn" Content="Delete" FontSize="12" Foreground="{DynamicResource C.Bad}"/>
            </StackPanel>
            <TextBlock Name="StatusText" FontSize="11" Foreground="{DynamicResource C.Ink3}"/>
            <TextBlock Classes="lbl" Text="PREVIEW (THE FICTIONAL DEMO RECORD)" Margin="0,4,0,0"/>
            <TextBlock Name="PreviewText" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource C.Ink2}"/>
            <TextBlock Name="PlaceholderHelp" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource C.Ink3}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Panel>
</Window>
