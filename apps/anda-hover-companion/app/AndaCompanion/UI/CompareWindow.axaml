<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.CompareWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — Compare two files">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource C.Hair}"/></Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="680">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Compare two files"/>
          <Button Grid.Column="1" Name="CloseBtn" Content="Close"/>
        </Grid>
        <ScrollViewer Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,14,0">
          <TextBlock Classes="hint" Text="Two versions of the same report. Everything here runs on this PC by fixed rules: no AI is used and nothing is sent."/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="lbl" Text="EARLIER FILE"/>
              <Button Name="PickA" Content="Choose the earlier file…"/>
              <TextBlock Name="NameA" Classes="hint" Text="No file yet."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="lbl" Text="LATER FILE"/>
              <Button Name="PickB" Content="Choose the later file…"/>
              <TextBlock Name="NameB" Classes="hint" Text="No file yet."/>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <Button Name="SampleBtn" Content="Use the sample files" Margin="0,0,10,6"/>
            <TextBlock Text="Match rows by" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource C.Ink2}" Margin="0,0,8,6"/>
            <ComboBox Name="KeyBox" MinWidth="220" IsEnabled="False" Margin="0,0,0,6" AutomationProperties.Name="Match rows by"/>
          </WrapPanel>
          <StackPanel Name="Out" Spacing="6"/>
          <Border Classes="rule"/>
          <WrapPanel>
            <Button Name="CopyBtn" Content="Copy the summary" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="CopyAllBtn" Content="Copy the full report" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="SaveBtn" Content="Save a report…" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="AiBtn" Content="Write a narrative with AI…" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock Name="Status" Classes="hint" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Classes="hint" Text="Reads Excel workbooks (.xlsx; one sheet, named beside the file name) and CSV files. The narrative uses your AI only after a preview, and only the summary and the listed changes are in it, never the files."/>
        </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Panel>
</Window>
