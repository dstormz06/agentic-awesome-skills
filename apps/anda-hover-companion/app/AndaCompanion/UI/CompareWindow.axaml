<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.CompareWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — Compare two files">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource C.Hair}"/></Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="680">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Compare two files"/>
          <Button Grid.Column="1" Name="CloseBtn" Content="Close"/>
        </Grid>
        <ScrollViewer Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,14,0">
          <TextBlock Classes="hint" Text="Two versions of the same report or document. Everything here runs on this PC by fixed rules: no AI is used and nothing is sent."/>
          <WrapPanel AutomationProperties.Name="What to compare">
            <Button Name="ModeTwoBtn" Classes="primary" Content="Two files" Margin="0,0,8,6"/>
            <Button Name="ModeDataBtn" Content="A report against my data" Margin="0,0,8,6"/>
            <Button Name="ModeWeekBtn" Content="My sheet since last week" Margin="0,0,8,6"/>
          </WrapPanel>
          <Grid Name="PickGrid" ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Name="LabelA" Classes="lbl" Text="EARLIER FILE"/>
              <Button Name="PickA" Content="Choose the earlier file…"/>
              <TextBlock Name="NameA" Classes="hint" Text="No file yet."/>
              <TextBlock Name="SaysA" Classes="hint" IsVisible="False"/>
            </StackPanel>
            <StackPanel Name="PickBPanel" Grid.Column="1" Spacing="4">
              <TextBlock Classes="lbl" Text="LATER FILE"/>
              <Button Name="PickB" Content="Choose the later file…"/>
              <TextBlock Name="NameB" Classes="hint" Text="No file yet."/>
              <TextBlock Name="SaysB" Classes="hint" IsVisible="False"/>
            </StackPanel>
          </Grid>
          <StackPanel Name="WeekPanel" IsVisible="False" Spacing="4">
            <CheckBox Name="WeekBox">
              <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource C.Ink}" Text="Keep one copy of my sheet each week, on this PC only, so I can see what changed. Off until I switch it on. Switching it off keeps the copies that exist; only you delete them."/>
            </CheckBox>
            <TextBlock Name="WeekCountText" IsVisible="False" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource C.Ink2}"/>
            <Button Name="WeekDelBtn" Content="Delete the kept copies…" IsVisible="False" HorizontalAlignment="Left"/>
          </StackPanel>
          <WrapPanel>
            <Button Name="SampleBtn" Content="Use the sample files" Margin="0,0,10,6"/>
            <Button Name="SampleDocsBtn" Content="Use two sample letters" Margin="0,0,10,6"/>
            <Button Name="SampleReportBtn" Content="Use the sample report" Margin="0,0,10,6" IsVisible="False"/>
            <StackPanel Name="KeyRow" Orientation="Horizontal">
              <TextBlock Text="Match rows by" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource C.Ink2}" Margin="0,0,8,6"/>
              <ComboBox Name="KeyBox" MinWidth="220" IsEnabled="False" Margin="0,0,0,6" AutomationProperties.Name="Match rows by"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel Name="Out" Spacing="6"/>
          <Border Classes="rule"/>
          <WrapPanel>
            <Button Name="CopyBtn" Content="Copy the summary" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="CopyAllBtn" Content="Copy the full report" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="SaveBtn" Content="Save a report…" IsEnabled="False" Margin="0,0,8,6"/>
            <Button Name="AiBtn" Content="Write a narrative with AI…" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock Name="Status" Classes="hint" AutomationProperties.LiveSetting="Polite"/>
          <Border Classes="rule"/>
          <TextBlock Classes="lbl" Text="ASK WITH ONE OF MY PROMPTS · SHOWN TO YOU FIRST"/>
          <WrapPanel>
            <ComboBox Name="PromptBox" MinWidth="280" IsEnabled="False" Margin="0,0,8,6" AutomationProperties.Name="One of my stored prompts"/>
            <Button Name="UseBtn" Content="Use this prompt…" IsEnabled="False" Margin="0,0,8,6"/>
          </WrapPanel>
          <CheckBox Name="WholeBox">
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource C.Ink}" Text="Also give it the beginning of each file (up to 6,000 characters each). Without this, the prompt gets only the differences the rules found."/>
          </CheckBox>
          <Border Classes="rule"/>
          <TextBlock Classes="lbl" Text="CHECK AN AI ANSWER · ON THIS PC, NO AI"/>
          <TextBox Name="AnswerBox" AcceptsReturn="True" TextWrapping="Wrap" Height="74" MaxLength="200001" FontSize="13"
                   Watermark="Paste an answer about these files here. Every number, date and name with a digit in it is looked up in the comparison and in the two files."
                   AutomationProperties.Name="An AI answer to check"/>
          <WrapPanel><Button Name="CheckBtn" Content="Check the answer" IsEnabled="False"/></WrapPanel>
          <StackPanel Name="CheckOut" Spacing="4" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock Classes="hint" Text="Reads Excel workbooks (.xlsx; one sheet, named beside the file name), CSV files, Word documents (.docx; the body text only) and plain text (.txt, .md). Nothing goes to an AI unless you press Send on a preview that shows every character."/>
        </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Panel>
</Window>
