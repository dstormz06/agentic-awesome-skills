<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.ChipWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Title="ANDA whisper">
  <Panel Margin="16">
    <Border Name="Pill" Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="99" Padding="14,9"
            BoxShadow="0 8 24 -6 #4D000000" Cursor="Hand">
      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <Ellipse Name="Dot" Width="7" Height="7" Fill="{DynamicResource C.Accent}"/>
        <TextBlock Name="ChipText" FontSize="12.5" FontWeight="SemiBold"
                   FontFamily="{DynamicResource C.Font}" Foreground="{DynamicResource C.Ink}"/>
        <TextBlock Name="GoText" FontSize="12.5" FontWeight="Bold"
                   Foreground="{DynamicResource C.Accent}" Text="Peek ›"/>
      </StackPanel>
    </Border>
  </Panel>
</Window>
