<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.TodoWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — To-do list">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource C.Hair}"/></Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="640">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="To-do list"/>
          <Button Grid.Column="1" Name="CloseBtn" Content="Done"/>
        </Grid>
        <TextBlock Name="Summary" Classes="hint"/>
        <TextBlock Name="LiveLine" FontSize="11" Foreground="{DynamicResource C.Ink3}" TextWrapping="Wrap"/>
        <Border Classes="rule"/>
        <Grid ColumnDefinitions="*,8,150,8,Auto">
          <TextBox Name="AddBox" MaxLength="200" Watermark="Add something to do…" AutomationProperties.Name="New to-do item"/>
          <ComboBox Grid.Column="2" Name="DueBox" HorizontalAlignment="Stretch" AutomationProperties.Name="Due date for the new item"/>
          <Button Grid.Column="4" Name="AddBtn" Classes="primary" Content="Add"/>
        </Grid>
        <TextBlock Name="AddStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="Rows" Spacing="2"/>
        </ScrollViewer>
        <Border Classes="rule"/>
        <Grid ColumnDefinitions="Auto,8,Auto,*">
          <Button Name="RefreshBtn" Content="Refresh now"/>
          <Button Grid.Column="2" Name="ClearBtn" Content="Clear finished"/>
        </Grid>
        <TextBlock Name="Footer" Classes="hint"/>
      </StackPanel>
    </Border>
  </Panel>
</Window>
