<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.SettingsWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — Settings">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/>
    </Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="440">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Settings"/>
          <Button Grid.Column="1" Name="CloseBtn" Classes="primary" Content="Done"/>
        </Grid>
        <!-- Is the app actually connected to an API? Always visible, never implied. -->
        <Border Name="ConnBanner" CornerRadius="8" Padding="10,7" Background="{DynamicResource C.Mark}">
          <Grid ColumnDefinitions="Auto,8,*">
            <Ellipse Name="ConnBannerDot" Width="9" Height="9" VerticalAlignment="Center" StrokeThickness="1.6"/>
            <StackPanel Grid.Column="2" Spacing="1">
              <TextBlock Name="ConnBannerLabel" FontSize="11.5" FontWeight="Bold"/>
              <TextBlock Name="ConnBannerText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource C.Ink2}"/>
            </StackPanel>
          </Grid>
        </Border>
        <ComboBox Name="JumpBox" HorizontalAlignment="Stretch" PlaceholderText="Go to a section…" AutomationProperties.Name="Go to a section"/>
        <!-- Scrolls only when the screen is too short to show every section (small laptops). -->
        <ScrollViewer Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,2,0">

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="APPEARANCE · FULL CARD"/>
          <UniformGrid Name="AppearancePanel" Columns="2"/>
          <TextBlock Classes="lbl" Margin="0,6,0,0" Text="APPEARANCE · COMPACT BOX"/>
          <UniformGrid Name="CompactPanel" Columns="2"/>
          <TextBlock Classes="hint" Text="Compact boxes are small enough to leave an open email readable. They make no AI call; click one (or press Enter) to open its full card. All looks share identical anatomy and meaning — this is preference, never information."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="AUTO-HIDE"/>
          <WrapPanel Name="AutoHidePanel"/>
          <TextBlock Classes="hint" Text="Hides a card or box after this long with no mouse or key activity. It never hides while your pointer is over it, while it is pinned, or while the drawer is open."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="CONSENT MODEL"/>
          <StackPanel Name="ConsentPanel" Spacing="2"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="URGENT ANDAs"/>
          <CheckBox Name="EscalateCheck">
            <TextBlock Text="In whisper mode, open a peek by itself for an urgent or at-risk ANDA" TextWrapping="Wrap"/>
          </CheckBox>
          <WrapPanel Name="LatePanel"/>
          <TextBlock Classes="hint" Text="At risk = forecast this many days after the goal, a serious attention item, or a passed goal date. It still starts only when you select a number and press the shortcut; nothing ever opens on its own. A peek makes no AI call."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="SELECT &amp; PEEK"/>
          <CheckBox Name="CaptureCheck">
            <TextBlock Text="Read my selection by copying it, then put my clipboard back" TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock Classes="hint" Text="Off: Ctrl+Alt+A opens the lookup box instead and no keystroke is ever sent. Terminals are always skipped, because Ctrl+C there interrupts a running command."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="SHORTCUTS · CLICK A BOX, THEN PRESS THE KEYS"/>
          <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
            <TextBlock Text="Select &amp; Peek" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource C.Ink2}"/>
            <TextBox Grid.Column="1" Name="PeekKeyBox" IsReadOnly="True" AutomationProperties.Name="Select and Peek shortcut"/>
            <Button Grid.Column="2" Name="PeekKeyReset" Content="Reset"/>
            <TextBlock Grid.Row="1" Text="Lookup box" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource C.Ink2}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="LookupKeyBox" IsReadOnly="True" AutomationProperties.Name="Lookup shortcut"/>
            <Button Grid.Row="1" Grid.Column="2" Name="LookupKeyReset" Content="Reset"/>
            <TextBlock Grid.Row="2" Text="Check a draft" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource C.Ink2}"/>
            <TextBox Grid.Row="2" Grid.Column="1" Name="DraftKeyBox" IsReadOnly="True" AutomationProperties.Name="Check a draft shortcut"/>
            <Button Grid.Row="2" Grid.Column="2" Name="DraftKeyReset" Content="Reset"/>
          </Grid>
          <TextBlock Name="KeyStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <TextBlock Classes="hint" Text="Use at least two modifiers, one of them Ctrl or Alt, so everyday shortcuts like Ctrl+C keep working. On keyboards where Ctrl+Alt is AltGr, choose Ctrl+Shift instead. Windows reports at once if another program already owns a shortcut."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="OTHER WAYS TO START IT"/>
          <CheckBox Name="MiddleCheck">
            <TextBlock Text="Middle-click (wheel button) on selected text starts Select &amp; Peek" TextWrapping="Wrap"/>
          </CheckBox>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Hold" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource C.Ink2}" Margin="0,0,8,0"/>
            <WrapPanel Name="MiddleModPanel"/>
          </StackPanel>
          <TextBlock Name="MiddleStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <TextBlock Classes="hint" Text="Off by default. It uses a Windows mouse hook that sees only the middle button, never the pointer position or any text, and the click still reaches the program under it. Some security software flags mouse hooks. A plain middle-click scrolls or opens links in many programs, so Ctrl is recommended. The shortcuts above and the tray icon always work."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="WEEKEND AND HOLIDAY WARNING"/>
          <WrapPanel Name="HolidayPanel"/>
          <TextBlock Classes="hint" Text="Flags a goal or forecast date on a weekend or federal holiday, or this many business days before or after a federal holiday. It shows the nearest business days; it does not decide how a date is handled."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="MY DATA · YOUR OWN FILES, READ-ONLY, ON THIS PC"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="PortfolioBox" IsReadOnly="True" Watermark="Your ANDA portfolio (.xlsx or .csv). Empty = fictional demo data." AutomationProperties.Name="Portfolio file"/>
            <Button Grid.Column="1" Name="PortfolioChoose" Content="Choose…"/>
            <Button Grid.Column="2" Name="PortfolioClear" Content="Clear"/>
          </Grid>
          <TextBlock Name="PortfolioStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <Expander Name="ColumnsExpander" IsVisible="False" Header="Match my columns">
            <StackPanel Name="ColumnsPanel" Spacing="4" Margin="0,4,0,0"/>
          </Expander>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="NotesBox" IsReadOnly="True" Watermark="Folder with your notes (.txt, .md, .docx)" AutomationProperties.Name="Notes folder"/>
            <Button Grid.Column="1" Name="NotesChoose" Content="Choose…"/>
            <Button Grid.Column="2" Name="NotesClear" Content="Clear"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="ReferenceBox" IsReadOnly="True" Watermark="Drugs@FDA data file you downloaded (.zip), for the RLD labeling date" AutomationProperties.Name="Drugs@FDA file"/>
            <Button Grid.Column="1" Name="ReferenceChoose" Content="Choose…"/>
            <Button Grid.Column="2" Name="ReferenceClear" Content="Clear"/>
          </Grid>
          <TextBlock Name="ReferenceStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Name="ReferenceUrlBox" Watermark="Optional: the https address of the Drugs@FDA data file, to update it from FDA" AutomationProperties.Name="Drugs@FDA data file address"/>
            <Button Grid.Column="1" Name="ReferenceUpdate" Content="Update now"/>
          </Grid>
          <TextBlock Name="ReferenceUpdateStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <TextBlock Classes="hint" Text="Update now fetches that one address, only when you press it, and keeps the file only if it really is a Drugs@FDA data file. It needs the network and is the only thing here that does. The address is the file link on FDA's Drugs@FDA data files page; this app does not guess it. The PSG line has no official source connected: it shows a date from a PSG column in your own sheet, or says it is not available."/>
          <TextBlock Classes="hint" Text="This tool only reads these files and never changes them. Nothing is sent anywhere. It shows only what your sheet contains: a forecast or progress that is not in it stays blank. The PSG date shown is the one in your own sheet; no official PSG source is connected yet."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="MY WRITING · TONE, STYLE, SIGN-OFF, QUICK REPLIES"/>
          <WrapPanel Name="TonePanel"/>
          <TextBox Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                   Watermark="Your style in your own words. For example: plain words, no jargon, keep it under 120 words."
                   AutomationProperties.Name="My standing writing instructions"/>
          <TextBox Name="SignOffBox" Watermark="How you sign off, for example: Thanks, Pat" AutomationProperties.Name="My sign-off"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Name="RepliesSummary" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Name="RepliesManage" Content="Quick replies…" Foreground="{DynamicResource C.Accent}" Background="{DynamicResource C.Mark}"/>
          </Grid>
          <TextBlock Classes="hint" Text="Tone, style and sign-off steer Proofread, Rewrite and Fact-check (only once a model is approved). They can never override the fixed rules: no changed numbers or dates, no invented facts. Quick replies are templates filled from the card (no AI): the Quick replies button on a card copies one with its numbers and dates filled in."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="CARD TRANSPARENCY"/>
          <Grid ColumnDefinitions="*,10,Auto">
            <Slider Name="OpacitySlider" Minimum="85" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="2" Name="OpacityLabel" FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource C.Ink2}" Width="42" TextAlignment="Right"/>
          </Grid>
          <TextBlock Classes="hint" Text="Only the card surface becomes translucent — text and status colors always stay fully readable."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="COMPANION LENS · PROMPT LIBRARY"/>
          <Grid ColumnDefinitions="*,8,Auto">
            <ComboBox Name="LensCombo" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Name="ManagePromptsBtn" Content="Manage…" Foreground="{DynamicResource C.Accent}" Background="{DynamicResource C.Mark}"/>
          </Grid>
          <TextBlock Classes="hint" Text="Your own stored prompt steers the brief's emphasis. Lenses can never override grounding — every claim still cites the record."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="CONNECTION · WHICH API, IF ANY"/>
          <WrapPanel Name="ProviderPanel"/>
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock Name="ConnStatus" FontSize="12" Foreground="{DynamicResource C.Ink2}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Name="TestBtn" Classes="primary" Content="Test" VerticalAlignment="Top"
                    ToolTip.Tip="Send one tiny request to prove the channel end to end"/>
          </Grid>
          <TextBox Name="ClaudeModelBox" Watermark="Claude model name (default: claude-opus-4-8)" AutomationProperties.Name="Claude model name"/>
          <Expander Name="MyApiExpander" Header="My API: the address, header and body of my own service">
            <StackPanel Spacing="5" Margin="0,4,0,0">
              <TextBox Name="ApiName" Watermark="A name for it, for example Division API" AutomationProperties.Name="My API name"/>
              <TextBox Name="ApiEndpoint" Watermark="https://… (the address your service gives you)" AutomationProperties.Name="My API address"/>
              <Grid ColumnDefinitions="*,8,*">
                <TextBox Name="ApiHeader" Watermark="Header, for example Authorization" AutomationProperties.Name="My API token header"/>
                <TextBox Grid.Column="2" Name="ApiScheme" Watermark="Before the token, for example Bearer" AutomationProperties.Name="My API token prefix"/>
              </Grid>
              <TextBox Name="ApiEnvVar" Watermark="NAME of the environment variable that holds the token (never the token)" AutomationProperties.Name="My API token variable name"/>
              <TextBox Name="ApiModel" Watermark="Model or agent name, if your service wants one" AutomationProperties.Name="My API model"/>
              <TextBox Name="ApiTemplate" AcceptsReturn="True" TextWrapping="Wrap" Height="96" FontFamily="{DynamicResource C.NumFont}" FontSize="11.5"
                       Watermark="Request body (JSON). Placeholders: {{system}} {{user}} {{max_tokens}} {{model}}" AutomationProperties.Name="My API request body"/>
              <TextBox Name="ApiPath" Watermark="Where the reply text is, for example choices[0].message.content" AutomationProperties.Name="My API reply path"/>
              <WrapPanel Name="ApiTimeoutPanel"/>
              <TextBlock Classes="hint" Text="Nothing here is a secret: the token stays in the environment variable you name and is never saved by this app. Only https:// addresses are used (http:// for localhost). The body shown is only an example of one common shape; use the shape your own service documents. A reply that does not have text at the path is reported without showing what came back."/>
            </StackPanel>
          </Expander>
          <TextBlock Classes="hint" Text="Auto uses a key (ANTHROPIC_API_KEY) or Elsa setup from the environment if one exists, and is otherwise offline. Offline never sends anything. The app is fully functional offline. This line is the truth: it says Connected only after a request has really succeeded."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="EDGE EXTENSION · OPTIONAL"/>
          <TextBlock Name="ExtStatus" FontSize="12" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <TextBox Name="ExtIdBox" FontSize="12" FontFamily="{DynamicResource C.NumFont}" AutomationProperties.Name="Extension ID"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="ExtConnect" Classes="primary" Content="Connect"/>
            <Button Name="ExtDisconnect" Content="Disconnect"/>
          </StackPanel>
          <TextBlock Classes="hint" Text="Lets the ANDA Companion (Notula) extension in Edge read your data through this app, so both show the same facts. Current user only, no admin rights, and only the extension ID above can use it. The extension also works without this app."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="OUTLOOK · OPTIONAL, READ-ONLY"/>
          <CheckBox Name="OutlookOn">
            <TextBlock Text="Show recent Outlook mail about the open ANDA" TextWrapping="Wrap"/>
          </CheckBox>
          <StackPanel Name="OutlookFields" Spacing="5">
            <WrapPanel Name="OutlookCloudPanel"/>
            <TextBox Name="OutlookClientId" Watermark="Application (client) ID your organization gave you" AutomationProperties.Name="Outlook application ID" FontFamily="{DynamicResource C.NumFont}" FontSize="12"/>
            <TextBox Name="OutlookTenant" Watermark="Directory (tenant): organizations, or your organization's domain" AutomationProperties.Name="Outlook directory"/>
            <WrapPanel Name="OutlookMaxPanel"/>
            <TextBlock Name="OutlookStatus" FontSize="12" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Name="OutlookSignIn" Classes="primary" Content="Sign in" Margin="0,0,8,6"/>
              <Button Name="OutlookOpen" Content="Open the sign-in page" Margin="0,0,8,6" IsVisible="False"/>
              <Button Name="OutlookCopy" Content="Copy code" Margin="0,0,8,6" IsVisible="False"/>
              <Button Name="OutlookSignOut" Content="Sign out" Margin="0,0,8,6"/>
            </WrapPanel>
          </StackPanel>
          <TextBlock Classes="hint" Text="Off by default. When on, an open card can list the latest messages that mention its six-digit number: sender, subject, date and a short preview. It is read-only and searches only for that number."/>
          <TextBlock Classes="hint" Text="You sign in on Microsoft's own page, so this app never sees your password. The sign-in stays in memory and ends when the app closes. Mail is never saved and never sent to an AI service."/>
          <TextBlock Classes="hint" Text="Your organization must register an app and allow mail access. Please ask your IT service desk for its Application (client) ID. This part was written from Microsoft's public documentation and tested against a stand-in server only, not against Microsoft."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="BACK UP, RESTORE, RESET"/>
          <WrapPanel>
            <Button Name="BackupSave" Content="Save a backup…" Margin="0,0,8,6"/>
            <Button Name="BackupRestore" Content="Restore a backup…" Margin="0,0,8,6"/>
            <Button Name="SettingsReset" Content="Reset all settings…" Margin="0,0,8,6"/>
          </WrapPanel>
          <TextBlock Name="BackupStatus" FontSize="11.5" Foreground="{DynamicResource C.Ink2}" TextWrapping="Wrap"/>
          <TextBlock Classes="hint" Text="A backup holds your settings, lenses and quick replies, so a new PC or a colleague can start from yours. It never holds a secret or a file location."/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="lbl" Text="USAGE LOG · FOR THE PILOT SCORECARD"/>
          <CheckBox Name="UsageCheck">
            <TextBlock Text="Keep a local log of what I use (date, event, seconds)" TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock Name="UsageHint" Classes="hint" Text="Never records ANDA numbers, drafts or any text. Off by default. It is a plain file you can read, and you share it only if you choose to."/>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Panel>
</Window>
