<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.LookupWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="Lookup ANDA">
  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="16" Width="340">
      <StackPanel Spacing="10">
        <TextBlock FontSize="9.5" FontWeight="Bold" LetterSpacing="1.4"
                   FontFamily="{DynamicResource C.LabelFont}"
                   Foreground="{DynamicResource C.Ink3}" Text="LOOKUP ANDA"/>
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Name="Input" Watermark="e.g. 216482" FontSize="14"
                   FontFamily="{DynamicResource C.NumFont}"/>
          <Button Grid.Column="2" Name="GoBtn" Content="Peek" FontWeight="SemiBold"
                  Foreground="{DynamicResource C.Accent}"/>
        </Grid>
        <TextBlock Name="ErrorText" FontSize="11.5" Foreground="{DynamicResource C.Bad}" IsVisible="False"/>
      </StackPanel>
    </Border>
  </Panel>
</Window>
