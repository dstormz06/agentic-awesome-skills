<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.LookupWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — Lookup">
  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="16" Width="340">
      <StackPanel Spacing="10">
        <TextBlock FontSize="11" FontWeight="Bold" LetterSpacing="1.4"
                   FontFamily="{DynamicResource C.LabelFont}"
                   Foreground="{DynamicResource C.Ink3}" Name="Caption" Text="LOOKUP ANDA"/>
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Name="Input" Watermark="e.g. 216482" FontSize="15" AutomationProperties.Name="ANDA number"
                   FontFamily="{DynamicResource C.NumFont}"/>
          <Button Grid.Column="2" Name="GoBtn" Content="Peek" FontWeight="SemiBold"
                  Foreground="{DynamicResource C.Accent}"/>
        </Grid>
        <TextBlock Name="ErrorText" FontSize="12" Foreground="{DynamicResource C.Bad}" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
        <!-- One Bar (round 33): what can be opened from what is typed. Rows to press; nothing opens by itself. -->
        <StackPanel Name="RowsPanel" Spacing="2" IsVisible="False" AutomationProperties.Name="Suggestions"/>
        <TextBlock Name="RowSay" FontSize="1" Opacity="0" Height="1" AutomationProperties.LiveSetting="Polite" IsHitTestVisible="False"/>
        <!-- The ANDAs kept in my list, then the recent ones (round 33). -->
        <WrapPanel Name="RecentPanel" IsVisible="False"/>
      </StackPanel>
    </Border>
  </Panel>
</Window>
