<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndaCompanion.UI.NotesWindow"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        SizeToContent="WidthAndHeight" CanResize="False" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Title="ANDA Companion (Notula) — Notes to checklist">

  <Window.Styles>
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{DynamicResource C.Font}"/></Style>
    <Style Selector="TextBlock.lbl">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.4"/><Setter Property="Foreground" Value="{DynamicResource C.Ink3}"/>
    </Style>
    <Style Selector="TextBlock.hint"><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{DynamicResource C.Ink2}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBox"><Setter Property="FontSize" Value="12.5"/></Style>
    <Style Selector="Border.rule"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource C.Hair}"/></Style>
  </Window.Styles>

  <Panel Margin="26">
    <Border Background="{DynamicResource C.Bg}" BorderBrush="{DynamicResource C.Line}"
            BorderThickness="1" CornerRadius="{DynamicResource C.Radius}"
            BoxShadow="0 18 42 -10 #59000000" Padding="20" Width="660">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource C.Ink}" Text="Notes to checklist"/>
          <Button Grid.Column="1" Name="CloseBtn" Content="Close"/>
        </Grid>
        <ScrollViewer Name="Body" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,2,0">

          <TextBlock Classes="lbl" Text="YOUR NOTES"/>
          <TextBox Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" MaxLength="6000"
                   Watermark="Paste or type your notes in any order. Or select them anywhere and press the My checklist shortcut."
                   AutomationProperties.Name="Your notes"/>
          <TextBlock Name="Hint" Classes="hint"/>

          <TextBlock Name="FoundLabel" Classes="lbl" Text="SUGGESTED ITEMS"/>
          <TextBlock Name="FoundNote" Classes="hint"/>
          <StackPanel Name="Found" Spacing="6"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="AddBtn" Classes="primary" Content="Add the ticked items"/>
            <Button Name="AllBtn" Content="Tick all"/>
            <Button Name="NoneBtn" Content="Untick all"/>
            <Button Name="UndoBtn" IsVisible="False" Content="Undo"/>
          </StackPanel>
          <TextBlock Name="Status" Classes="hint"/>
          <Border Classes="rule"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="OpenBtn" Content="Open my checklist"/>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Panel>
</Window>
