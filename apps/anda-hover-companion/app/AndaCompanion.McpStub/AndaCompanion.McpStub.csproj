<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in MCP server for the Windows-only tests (Round41WindowsTests): a harmless program that answers on its standard
       input and output with fictional words, reads no file and reaches no network. It is never part of the app or its package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
