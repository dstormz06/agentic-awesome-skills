<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <ProjectReference Include="../AndaCompanion/AndaCompanion.csproj" />
    <!-- built first, not referenced: the Windows-only tests start its .exe as a real program on this PC -->
    <ProjectReference Include="../AndaCompanion.McpStub/AndaCompanion.McpStub.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- the stub's program and its files, copied next to the tests as stub/, where Round41ProgramTests finds it -->
  <Target Name="CopyMcpStub" AfterTargets="Build">
    <ItemGroup>
      <McpStubFile Include="../AndaCompanion.McpStub/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Error Condition="'@(McpStubFile)' == ''" Text="AndaCompanion.McpStub was not built for $(Configuration); the tests need it." />
    <Copy SourceFiles="@(McpStubFile)" DestinationFolder="$(OutDir)stub" SkipUnchangedFiles="true" />
  </Target>
</Project>
