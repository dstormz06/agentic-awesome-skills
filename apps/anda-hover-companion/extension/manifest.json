{
  "manifest_version": 3,
  "name": "ANDA Hover Companion (prototype)",
  "short_name": "ANDA Companion",
  "version": "0.1.0",
  "description": "Select an ANDA number, get its forecast, watch flags and a draft check. Offline; fictional demo data until you add your own. Prototype, not an FDA product.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ANDA Hover Companion",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "commands": {
    "peek-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Peek at the selected ANDA number"
    },
    "check-draft": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Check the selected text (or the field you are typing in) as a draft"
    },
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan this page for ANDA numbers"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
